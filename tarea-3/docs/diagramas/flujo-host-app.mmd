%% flujo-host-app.mmd — Host Application Sparkplug B (página web)
%% Cada bloque [DF-4.x] se cita en el comentario JSDoc de la función que lo implementa
%% (hmi-web/sparkplug.js: núcleo sin DOM ni MQTT · hmi-web/app.js: vista y conexión).
%% Requisitos I-08 (STATE, Rebirth) e I-05 (estadística de las cuatro capas)
flowchart TD
    A(["[DF-4.1] Inicio<br/>cargar sparkplug_b.proto con protobuf.js<br/>toda métrica DESCONOCIDA (sin BIRTH: no válida)"])
    A --> B["[DF-4.2] CONNECT por WSS · usuario host_app · clean session<br/>cliente NUEVO por conexión · Will: STATE/HA01_WebDashboard<br/>{online: false, timestamp T} · retenido · QoS 1"]
    B -- "Falla o se corta" --> RX["[DF-4.13] Semáforo MQTT en rojo<br/>todo lo mostrado pasa a OBSOLETO<br/>comandos pendientes: SIN CONFIRMAR<br/>reintento con retroceso 1, 2, 4… 30 s"]
    RX --> B
    B -- "CONNACK" --> C["[DF-4.3] Suscribir spBv1.0/UNRaf_PdCI_2026/# y el STATE propio<br/>recién con el SUBACK: STATE {online: true, timestamp T}<br/>retenido · QoS 1 · sin BIRTH vigente → NCMD Rebirth"]
    C --> M(["[DF-4.4] Esperar mensaje"])
    M --> P["[DF-4.5] Partir el tópico<br/>namespace / group / tipo / nodo / dispositivo<br/>decodificar el payload Protobuf"]
    P --> T{"[DF-4.6] Tipo de mensaje"}
    T -- NBIRTH --> NB["[DF-4.7] bdSeq y seq de la sesión<br/>métricas del nodo EN LÍNEA (nombre + alias)<br/>dispositivo DESCONOCIDO hasta su DBIRTH"]
    T -- NDEATH --> ND{"[DF-4.8] ¿bdSeq = el del<br/>NBIRTH vigente?"}
    ND -- Sí --> ND1["Nodo y dispositivo OBSOLETOS<br/>(último valor, tachado)"]
    ND -- "No: Will de una sesión vieja" --> M
    T -- "NDATA · DBIRTH · DDATA · DDEATH" --> V{"[DF-4.9] ¿Hay NBIRTH<br/>de esta sesión?"}
    V -- No --> RB
    V -- Sí --> S{"[DF-4.10] ¿seq = (anterior + 1) mod 256?"}
    S -- "No: se perdieron mensajes" --> RB["[DF-4.11] NCMD Node Control/Rebirth = true<br/>como máximo 1 cada 5 s · contador y aviso en pantalla"]
    RB --> U
    S -- Sí --> U["[DF-4.12] Aplicar: alias → métrica del BIRTH<br/>(alias desconocido → Rebirth) · DBIRTH: EN LÍNEA · DDEATH: OBSOLETO<br/>DDATA con el valor pedido → comando CONFIRMADO<br/>semáforo por capa: color + ícono + texto"]
    NB --> U
    ND1 --> U
    U --> M
    M -- "El usuario acciona una salida" --> CMD["[DF-4.14] Solo con el dispositivo EN LÍNEA:<br/>DCMD por alias (103 LedDigital · 104 LedPWM), sin seq, QoS 0<br/>comando ENVIADO · la vista NO cambia<br/>5 s sin DDATA → SIN CONFIRMAR"]
    CMD --> M
