        "format": "/*\n * estilo.css — estilo comun de los paneles del Dashboard (ui-template de alcance \"site:style\")\n * Autores: Bevilacqua Francisco, Peralta Agustina · 2026-11-09 · v1.0\n * Sobrio, azul marino y gris (estilo de documentos del grupo).\n */\n.pdci-tabla th {\n  background: #1f3864;\n  color: #ffffff;\n  font-weight: 600;\n  text-align: left;\n  padding: 4px 8px;\n  position: sticky;\n  top: 0;\n  z-index: 1;\n}\n.pdci-tabla td {\n  padding: 2px 8px;\n  border-bottom: 1px solid #d9d9d9;\n  vertical-align: middle;\n}\n.pdci-tabla tbody tr:nth-child(even) td {\n  background: #f2f4f8;\n}\ncode {\n  font-family: Consolas, \"Courier New\", monospace;\n  font-size: 0.85rem;\n}\n",
