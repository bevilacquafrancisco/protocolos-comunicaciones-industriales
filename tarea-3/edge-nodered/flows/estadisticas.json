    {
        "id": "a86e15b27222ddce",
        "type": "ui-template",
        "z": "17da27453ae82382",
        "name": "panel tramas",
        "x": 620,
        "y": 100,
        "group": "15532488d30cc40f",
        "page": "",
        "ui": "",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<!--\n  tramas.vue — Ultima trama transmitida y recibida, latencia y detalle de errores\n  Autores: Bevilacqua Francisco, Peralta Agustina · 2026-11-09 · v1.0\n  Muestra la trama REAL que esta en el bus, en hexadecimal: sirve para la defensa y para el\n  analisis byte a byte del informe sin sonda ni osciloscopio. Recibe {topic:'tramas'} (E1).\n-->\n<template>\n  <div v-if=\"s\">\n    <div><b>Esclavo</b> Unit ID {{ s.esclavo }} · {{ s.puerto }}</div>\n    <div class=\"mt-2\"><b>TX</b> <code>{{ s.ultimaTx || '-' }}</code></div>\n    <div><b>RX</b> <code>{{ s.ultimaRx || '-' }}</code></div>\n    <div class=\"mt-2\">Latencia petición → respuesta completa: <b>{{ s.latenciaMs === null ? '-' : s.latenciaMs + ' ms' }}</b>\n      <span class=\"text-caption\">(incluye la transmisión de ambas tramas y la latencia del conversor USB)</span></div>\n    <div>Ciclos completos: <b>{{ s.ciclos }}</b> · duración del último: <b>{{ s.duracionCicloMs === null ? '-' : s.duracionCicloMs + ' ms' }}</b></div>\n    <div class=\"text-caption mt-2\">\n      Detalle de CRC_ERROR: CRC inválido {{ s.contadores.detalle.CRC_ERROR }} · trama mal formada\n      {{ s.contadores.detalle.MALFORMED }} · otro Unit ID {{ s.contadores.detalle.WRONG_SLAVE }} ·\n      bytes fuera de transacción {{ s.contadores.detalle.BYTES_ESPURIOS }}\n      <span v-if=\"s.ultimaExcepcion\"> · última excepción {{ s.ultimaExcepcion }}</span>\n    </div>\n  </div>\n  <div v-else class=\"text-caption\">Esperando al maestro…</div>\n</template>\n\n<script>\nexport default {\n  data () { return { s: null } },\n  watch: { msg: function (m) { if (m && m.topic === 'tramas') this.s = m.payload } },\n  mounted () { if (this.msg && this.msg.topic === 'tramas') this.s = this.msg.payload }\n}\n</script>\n",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "wires": [
            []
        ]
    },
    {
        "id": "6761f5da46ce7424",
        "type": "ui-template",
        "z": "17da27453ae82382",
        "name": "panel historial",
        "x": 620,
        "y": 140,
        "group": "77431f0b38c1193f",
        "page": "",
        "ui": "",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<!--\n  historial.vue — Historico breve de eventos de las cuatro capas\n  Autores: Bevilacqua Francisco, Peralta Agustina · 2026-11-09 · v1.0\n  Recibe {topic:'historial', payload:[{ts, nivel, capa, texto}]} (E1), del mas nuevo al mas viejo.\n  Solo se registran transiciones y acciones, no cada peticion: un historial que se llena de\n  ruido no sirve para diagnosticar.\n  NOTA: tablas con <table> nativo y NO con <v-table>: Dashboard 2.0 compila la plantilla con el\n  analizador HTML del navegador, que saca <tr> de cualquier elemento que no sea <table> y deja\n  el v-for fuera de la fila (error \"Cannot read properties of undefined\" en el render).\n-->\n<template>\n  <div style=\"max-height: 320px; overflow-y: auto\"><table class=\"pdci-tabla\" style=\"width: 100%; border-collapse: collapse; font-size: 0.875rem\">\n    <thead><tr><th style=\"width: 90px\">Hora</th><th style=\"width: 100px\">Capa</th><th style=\"width: 70px\">Nivel</th><th>Evento</th></tr></thead>\n    <tbody>\n      <tr v-for=\"(evento, i) in eventos\" :key=\"i\">\n        <td>{{ hora(evento.ts) }}</td>\n        <td>{{ evento.capa }}</td>\n        <td><v-chip size=\"x-small\" :color=\"evento.nivel === 'info' ? 'primary' : (evento.nivel === 'aviso' ? 'warning' : 'error')\">{{ evento.nivel }}</v-chip></td>\n        <td>{{ evento.texto }}</td>\n      </tr>\n      <tr v-if=\"!eventos.length\"><td colspan=\"4\" class=\"text-caption\">Sin eventos todavía.</td></tr>\n    </tbody>\n  </table></div>\n</template>\n\n<script>\nexport default {\n  data () { return { eventos: [] } },\n  watch: { msg: function (m) { if (m && m.topic === 'historial') this.eventos = m.payload || [] } },\n  mounted () { if (this.msg && this.msg.topic === 'historial') this.eventos = this.msg.payload || [] },\n  methods: {\n    hora (ts) {\n      const d = new Date(ts)\n      return [d.getHours(), d.getMinutes(), d.getSeconds()].map((n) => String(n).padStart(2, '0')).join(':')\n    }\n  }\n}\n</script>\n",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "wires": [
            []
        ]
    },
