    {
        "id": "a899e64e6f6ebf51",
        "type": "function",
        "z": "17da27453ae82382",
        "name": "E1 · cuatro capas",
        "x": 360,
        "y": 100,
        "func": "// =====================================================================\n// E1 · cuatro capas — I-05 (estadistica de las cuatro capas en todo momento)\n// ---------------------------------------------------------------------\n// Descripcion: cada 1 s arma la instantanea de las cuatro capas (MODBUS en\n//   F3; OPC UA, MQTT y Sparkplug B se registran en F4/F5 con\n//   pdci.capas.actualizar) y el historial de eventos. Va por tiempo y no por\n//   eventos para que el panel se actualice aunque una capa este caida y no\n//   produzca mensajes: justo cuando mas importa verla.\n// Salidas: [1] tarjetas de las capas  [2] tramas y tiempos  [3] historial\n// =====================================================================\nconst pdci = global.get('pdci');\nconst capas = pdci.capas.instantanea();\nconst modbus = global.get('pdci_modbus') || null;\nreturn [\n    { topic: 'capas', payload: capas },\n    { topic: 'tramas', payload: modbus },\n    { topic: 'historial', payload: pdci.historial.ultimos(40) },\n];\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "outputLabels": [
            "capas",
            "tramas",
            "historial"
        ],
        "wires": [
