# .env.example - plantilla de variables de entorno de la Tarea 3
#
# Copiar a .env (o a /etc/pdci-t3.env en la Raspberry Pi) y completar.
# El .env real NUNCA va al repositorio (.gitignore) y se crea con permisos 600:
#     install -m 600 /dev/null .env
#
# Los valores de ejemplo son marcadores: ninguno es una credencial real.

# =============================================================================
# Dispositivo 2 - Raspberry Pi: maestro MODBus + servidor OPC UA (Node-RED)
# =============================================================================

# El puerto serie, el Unit ID y el mapa NO van aca: se configuran en vivo desde el Dashboard
# y se guardan en <userDir>/pdci-t3-config.json (I-04). Nombres leidos por edge-nodered/settings.js.

# Usuario OPC UA con permiso de escritura. Solo se guarda el HASH scrypt, nunca la clave.
# Generarlo con: node tools/generar_hash_opcua.js   (acepta tambien hashes de la T2)
# Sin estas dos variables el servidor solo admite anonimo (lectura).
PDCI_T3_OPCUA_USUARIO=operador
PDCI_T3_OPCUA_HASH=scrypt:131072:8:1:<sal>:<hash>

# Puerto del servidor OPC UA (escucha en todas las interfaces; el firewall de la placa decide).
PDCI_T3_OPCUA_PUERTO=4840
# PKI del servidor (certificado, clave privada, lista de confianza). FUERA del repositorio.
PDCI_T3_OPCUA_PKI=/home/pi/.node-red/opcua-pki

# =============================================================================
# Dispositivo 3 - PC/VM: cliente OPC UA + Edge Node Sparkplug B (Python)
# =============================================================================

# IP literal del dispositivo 2, nunca un nombre de host (regla heredada de la T2).
OPCUA_URL=opc.tcp://192.168.10.1:4840
OPCUA_SEGURIDAD=SignAndEncrypt
OPCUA_CLIENTE_USUARIO=operador
OPCUA_CLIENTE_CLAVE=<clave-del-usuario-opcua>

# Broker MQTT en la nube (I-03: nunca localhost en la demo).
MQTT_HOST=<id-del-cluster>.<proveedor-del-broker>
MQTT_PUERTO_TLS=8883
MQTT_USUARIO_EDGE=edge_node
MQTT_CLAVE_EDGE=<clave-del-usuario-edge_node>

# CA del broker (opcional): vacio = almacen de CAs del sistema, que alcanza para un broker en la
# nube con certificado publico. Solo hace falta con una CA propia.
MQTT_CA=
# PKI del cliente OPC UA (certificado propio, CLAVE PRIVADA y certificado del servidor). Fuera de
# git. Ruta ABSOLUTA, o vacio = tarea-3/gateway-sparkplug/pki.
OPCUA_PKI=
# Usuario de solo lectura para MQTT Explorer y tools/observador_sparkplug.py (ADR-005).
MQTT_USUARIO_OBSERVADOR=observador
MQTT_CLAVE_OBSERVADOR=<clave-del-usuario-observador>

# Identificadores Sparkplug B (docs/diccionario-de-datos.md §4).
SPB_GROUP_ID=UNRaf_PdCI_2026
SPB_EDGE_NODE_ID=EN01_Gateway
SPB_DEVICE_ID=DEV01_ESP32_Slave

# =============================================================================
# Host Application - pagina web
# =============================================================================
# La web es estatica: sus credenciales quedan visibles en el navegador (ADR-005).
# Por eso el usuario host_app tiene permisos minimos por topico en el broker.
MQTT_PUERTO_WSS=8884
MQTT_USUARIO_HOST=host_app
MQTT_CLAVE_HOST=<clave-del-usuario-host_app>
SPB_HOST_ID=HA01_WebDashboard
