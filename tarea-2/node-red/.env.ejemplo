# =====================================================================
# .env.ejemplo — plantilla de /etc/nodered-pdci.env
# Tarea 2 · PdCI · UNRaf
# ---------------------------------------------------------------------
# Este archivo NO contiene secretos: es la plantilla. En cada Raspberry Pi
# se copia a /etc/nodered-pdci.env (permisos 600) y se completan los
# valores. systemd lo carga en el servicio nodered (README.md §7).
#
# Formato: VARIABLE=valor, sin "export", sin espacios alrededor del "=" y
# SIN comillas. Los "$" de los hashes se escriben tal cual: systemd no los
# expande. (Si se cargara con "source" desde una shell, si los expandiria.)
# =====================================================================

# ---- Ambas placas ---------------------------------------------------
# Usuario y hash bcrypt del EDITOR de Node-RED. Hash: node-red admin hash-pw
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_HASH=
# Clave que cifra flows_cred.json. Generar con: openssl rand -hex 32
NODE_RED_CREDENTIAL_SECRET=

# ---- Solo RPi 1 (servidor) ------------------------------------------
# Usuario OPC UA y hash scrypt de su clave (Parte 4.9).
# Hash: node ~/pdci-t2/comun/credenciales.js
OPCUA_USUARIO=operador
OPCUA_CLAVE_HASH=

# ---- Solo RPi 2 (cliente) -------------------------------------------
# La clave EN CLARO del usuario OPC UA: el cliente la necesita para
# presentarla en ActivateSession. Solo se usa si en config.js
# seguridad.autenticacionCliente = 'usuario'.
OPCUA_CLIENTE_USUARIO=operador
OPCUA_CLIENTE_CLAVE=
